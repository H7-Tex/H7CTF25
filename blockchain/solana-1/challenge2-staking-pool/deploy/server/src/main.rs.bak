use sol_ctf_framework::ChallengeBuilder;
use solana_program::system_program;
use solana_sdk::{
    account::Account,
    pubkey::Pubkey,
    signature::{Keypair, Signer},
};
use std::{
    error::Error,
    fs,
    io::Write,
    net::{TcpListener, TcpStream},
};

const STARTING_BALANCE: u64 = 10_000_000_000; // 10 SOL
const ADMIN_POOL_BALANCE: u64 = 100_000_000_000; // 100 SOL in admin's pool
const WIN_THRESHOLD: u64 = 50_000_000_000; // Steal 50 SOL from admin pool

#[tokio::main]
async fn main() -> Result<(), Box<dyn Error>> {
    let listener = TcpListener::bind("0.0.0.0:5001")?;
    
    loop {
        let (stream, _) = listener.accept()?;
        tokio::spawn(async move {
            if let Err(e) = handle_connection(stream).await {
                eprintln!("handler error: {e}");
            }
        });
    }
}

async fn handle_connection(mut socket: TcpStream) -> Result<(), Box<dyn Error>> {
    writeln!(socket, "╔════════════════════════════════════════════════╗")?;
    writeln!(socket, "║        H7CTF 2025 - Staking Pool              ║")?;
    writeln!(socket, "╚════════════════════════════════════════════════╝\n")?;
    
    writeln!(socket, "⏳ Initializing challenge instance...\n")?;
    
    let mut builder = ChallengeBuilder::try_from(socket.try_clone().unwrap()).unwrap();

    // Create user keypair
    let user = Keypair::new();
    
    // Load challenge program
    let program_id = builder
        .add_program("./staking_pool.so", None)
        .expect("Failed to add staking pool program");

    // Setup user account with initial balance
    builder.builder.add_account(
        user.pubkey(),
        Account::new(STARTING_BALANCE, 0, &system_program::ID),
    );
    
    // Calculate admin pool PDA
    let admin_org = "MegaCorp";
    let admin_emp = "admin";
    let (admin_pool_pda, _) = Pubkey::find_program_address(
        &[admin_org.as_bytes(), admin_emp.as_bytes()],
        &program_id,
    );
    
    // Setup admin pool account with 100 SOL
    builder.builder.add_account(
        admin_pool_pda,
        Account::new(ADMIN_POOL_BALANCE, 0, &system_program::ID),
    );
    
    // Display credentials
    writeln!(socket, "✅ Instance ready!\n")?;
    
    writeln!(socket, "🔑 User Account:")?;
    writeln!(socket, "   Address: {}", user.pubkey())?;
    writeln!(socket, "   Balance: {} SOL", STARTING_BALANCE / 1_000_000_000)?;
    
    // Show private key in hex format (standard)
    let privkey_hex = user.to_bytes()
        .iter()
        .map(|b| format!("{:02x}", b))
        .collect::<String>();
    writeln!(socket, "   Private Key: {}\n", privkey_hex)?;
    
    writeln!(socket, "📦 Program:")?;
    writeln!(socket, "   Program ID: {}\n", program_id)?;
    
    writeln!(socket, "🎯 Target:")?;
    writeln!(socket, "   Admin Pool: {}", admin_pool_pda)?;
    writeln!(socket, "   Balance:    {} SOL", ADMIN_POOL_BALANCE / 1_000_000_000)?;
    writeln!(socket, "   Organization: {}", admin_org)?;
    writeln!(socket, "   Employee ID:  {}\n", admin_emp)?;
    
    writeln!(socket, "🎯 Objective: Steal {} SOL or more to win!\n", WIN_THRESHOLD / 1_000_000_000)?;
    writeln!(socket, "═══════════════════════════════════════════════\n")?;
    
    // NOW ask for the exploit program (BEFORE building!)
    let solve_pubkey = match builder.input_program() {
        Ok(pubkey) => pubkey,
        Err(e) => {
            writeln!(socket, "Error: cannot add solve program → {e}")?;
            return Ok(());
        }
    };
    
    let mut challenge = builder.build().await;

    // Run solve program
    writeln!(socket, "\n🔄 Running your exploit...\n")?;
    let ixs = challenge.read_instruction(solve_pubkey).unwrap();
    challenge.run_ixs_full(&[ixs], &[&user], &user.pubkey()).await?;

    // Check if solved
    let user_balance = challenge
        .ctx
        .banks_client
        .get_account(user.pubkey())
        .await?
        .unwrap()
        .lamports;
    
    writeln!(socket, "📊 Results:")?;
    writeln!(socket, "   Your balance: {} SOL", user_balance / 1_000_000_000)?;

    if user_balance >= WIN_THRESHOLD {
        let flag = fs::read_to_string("/flag.txt")
            .or_else(|_| fs::read_to_string("flag.txt"))
            .unwrap_or_else(|_| "H7CTF{test_flag_staking_pool}".to_string());
        writeln!(socket, "\n🎉 Congratulations! You exploited the PDA collision!")?;
        writeln!(socket, "🚩 Flag: {}", flag)?;
    } else {
        writeln!(socket, "\n❌ Not enough SOL stolen. Keep trying!")?;
    }

    Ok(())
}