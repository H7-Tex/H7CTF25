    {
      "name": "Images",
      "item": [
        {
          "name": "Upload Image",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Automatically save the image_id to environment variable",
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"IMAGE_ID\", jsonData.image_id);",
                  "    console.log(\"Image ID saved to environment:\", jsonData.image_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{AUTH_TOKEN}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "X-NEURALEND-KEY",
                "value": "{{X_NEURALEND_KEY}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{BASE_URL}}/api/upload-image",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "upload-image"]
            },
            "description": "Upload an image file. Select an image file to upload. The image ID will be automatically saved to environment variable."
          },
          "response": []
        },
        {
          "name": "Get Image",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-NEURALEND-KEY",
                "value": "{{X_NEURALEND_KEY}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/images/{{IMAGE_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "images", "{{IMAGE_ID}}"]
            },
            "description": "Retrieve an uploaded image by its ID. Uses the IMAGE_ID from environment or you can replace it with a specific ID."
          },
          "response": []
        }
      ],
