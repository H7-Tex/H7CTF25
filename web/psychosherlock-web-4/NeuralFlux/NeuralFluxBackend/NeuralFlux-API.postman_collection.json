    {
      "name": "Authentication",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Automatically save the token to environment variable",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"AUTH_TOKEN\", jsonData.token);",
                  "    console.log(\"Token saved to environment:\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-NEURALEND-KEY",
                "value": "{{X_NEURALEND_KEY}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{ADMIN_USERNAME}}\",\n    \"password\": \"{{ADMIN_PASSWORD}}\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/admin/login",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "admin", "login"]
            },
            "description": "Login with admin credentials to get JWT token. Token is automatically saved to environment variable."
          },
          "response": []
        },
        {
          "name": "Change Password",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{AUTH_TOKEN}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "X-NEURALEND-KEY",
                "value": "{{X_NEURALEND_KEY}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"current_password\": \"{{ADMIN_PASSWORD}}\",\n    \"new_password\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/admin/change-password",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "admin", "change-password"]
            },
            "description": "Change admin password (requires authentication)"
          },
          "response": []
        }
      ],
      "description": "Authentication related endpoints"
    },
